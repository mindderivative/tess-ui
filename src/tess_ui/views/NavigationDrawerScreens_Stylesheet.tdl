# The look of the screens drawer: section headings in on_surface_variant.
Styles {
  Rule {
    Widget: NavigationDrawerScreens
    Part: heading
    Style { Foreground: on_surface_variant, Padding { Left: 16, Right: 16, Top: 18, Bottom: 18 } }
  }
}
