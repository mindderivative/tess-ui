---
TDL: 0.2
Name: Tree
Tesserae: "0.6"
---
# A tree (the WAI-ARIA tree pattern in Material 3's list terms): rows that open to show their children, one level inside the next (the rows are one flat list: each open branch's children follow it, so a screen reader hears each row's level, `pos_in_set` and `set_size`, not nested groups). `nodes` is a list of {value, label} and
# optionally {icon, children, disabled}, the children being the same shape. `expanded` is the list of values of the open branches and `selected` the value of the chosen row;
# both are two-way. A press on a row chooses it, and on a branch opens or closes it too. One Tab stop; the up and down arrows move through the rows that show, Right opens a branch
# and Left closes one, and typing the start of a label jumps to a row.
Container {
  Params {
    Nodes { Type: list, Default: [], Doc: "The rows: {value, label} and optionally {icon, children, disabled}; children are the same shape." }
    Expanded { Type: list, Default: [], Model: true, Doc: "The values of the branches that are open." }
    Selected { Type: any, Default: "", Model: true, Doc: "The value of the chosen row." }
    Selection { Type: list, Default: [], Model: true, Doc: "With `Multiple`: the values of the chosen rows. Two-way. A chosen row inside a closed branch stays in it." }
    Multiple { Type: bool, Default: false, Doc: "Choose several rows: click chooses one, Ctrl+click toggles, Shift+click and Shift+Arrow choose a range, Space toggles, Ctrl+A chooses every row that shows (AC-SLT-7). `Selected` then follows the last row pressed." }
    On_Change { Type: handler, Doc: "With `Multiple`: called after the chosen rows change, with `event.reason` (`pointer`, `keyboard` or `api`), `event.detail` (`select`, `toggle`, `range`, `all` or `clear`), `event.count`, `event.selection` (the chosen values) and `event.anchor`." }
    Compact { Type: bool, Default: false, Doc: "40 pixel rows instead of 56 (at no density)." }
    Density { Type: str, Default: "", Doc: "`default`, `compact` or `dense`: the spec's density table for the rows; empty follows the app's `App(density=)`." }
    Label { Type: str, Default: "Tree", Doc: "The tree's accessible name: what the pane is (Files, Structure), not the word Tree (AC-TRE-01)." }
  }
  Focus_Group: vertical
  Selection_Mode: <| 'multiple' if multiple else 'none' |>
  Selection: <| selection |>
  Selection_Announce: <| '{count} selected' if multiple else '' |>
  State { Current { } }
  Handlers {
    On_Selection_Change { Call { Action: "on_change", Args: [<| event |>] } }
    On_Key {
      Call { Action: "tree_focus", Args: [<| event.key |>, <| tree_row(nodes, expanded, current)['open'] |>, <| tree_row(nodes, expanded, current)['branch'] |>, <| tree_row(nodes, expanded, current)['level'] |>] }
      Set {
        Target: expanded
        Value: <| (expanded + [current]) if (event.key == 'arrow_right' and tree_row(nodes, expanded, current)['branch'] and not tree_row(nodes, expanded, current)['open']) else (([v for v in expanded if v != current]) if (event.key == 'arrow_left' and tree_row(nodes, expanded, current)['open']) else (expanded + [v for v in tree_row(nodes, expanded, current)['siblings_branches'] if v not in expanded] if event.key == '*' else expanded)) |>
      }
    }
  }
  A11y { Role: tree, Label: <| label |> }
  Style { Flex_Direction: vertical, Width: 100% }
  Children {
    For r In <| tree_rows(nodes, expanded) |> Key <| r['value'] |> {
      TreeNode {
        Name: row
        Label: <| r['label'] |>
        Icon: <| r['icon'] |>
        Level: <| r['level'] |>
        Set_Size: <| r['set_size'] |>
        Pos_In_Set: <| r['pos_in_set'] |>
        Branch: <| r['branch'] |>
        Expanded: <| r['open'] |>
        Selection_Key: <| r['value'] |>
        Selected: <| (r['value'] in selection) if multiple else (r['value'] == selected) |>
        Compact: <| compact |>
        Density: <| density |>
        Disabled: <| r['disabled'] |>
        Handlers {
          On_Focus_Enter { Set { Target: current, Value: <| r['value'] |> } }
          On_Click {
            Set { Target: selected, Value: <| r['value'] |> }
            Set {
              Target: expanded
              Value: <| ([v for v in expanded if v != r['value']] if r['open'] else expanded + [r['value']]) if (r['branch'] and not (event.ctrl or event.shift)) else expanded |>
            }
          }
        }
      }
    }
  }
}
