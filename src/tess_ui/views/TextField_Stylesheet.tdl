---
TDL: 0.1
Name: TextField
Tesserae: "0.6"
---
# The look of TextField (Material 3). A state here is the state of the whole field: `focused` is true while anything inside it has the focus.
# A later rule wins a tie, so error comes after focused and hovered: a field in error keeps the error colour while it is used.
Styles {
  Rule {
    Widget: TextField
    Style { Width: 280, Background: transparent }  # a fill, even a clear one, is what lets the pointer find the field
  }
  Rule {
    Widget: TextField
    State: disabled
    Style { Opacity: 0.38 }
  }

  # the box
  Rule {
    Widget: TextField
    Part: box
    Variant: filled
    Style { Background: surface_container_highest, Corner_Radius { Top: 4 } }  # square below: the line under it is its bottom edge
  }
  Rule {
    Widget: TextField
    Part: box
    Variant: outlined
    Style { Border_Width: 1, Border_Color: outline, Corner_Radius: 4 }
  }
  Rule {
    Widget: TextField
    Part: box
    Variant: outlined
    State: hovered
    Style { Border_Color: on_surface }
  }
  Rule {
    Widget: TextField
    Part: box
    Variant: outlined
    State: focused
    Style { Border_Width: 2, Border_Color: primary }
  }
  Rule {
    Widget: TextField
    Part: box
    Variant: outlined
    State: error
    Style { Border_Color: error }
  }

  # the line under a filled field
  Rule {
    Widget: TextField
    Part: indicator
    Style { Height: 1, Background: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: indicator
    State: hovered
    Style { Background: on_surface }
  }
  Rule {
    Widget: TextField
    Part: indicator
    State: focused
    Style { Height: 2, Background: primary }
  }
  Rule {
    Widget: TextField
    Part: indicator
    State: error
    Style { Background: error }
  }

  # the label
  Rule {
    Widget: TextField
    Part: label
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: label
    State: focused
    Style { Foreground: primary }
  }
  Rule {
    Widget: TextField
    Part: label
    State: error
    Style { Foreground: error }
  }

  # the typing, and the text around it
  Rule {
    Widget: TextField
    Part: input
    Style { Foreground: on_surface, Background: transparent }  # the box around the typing is the field's own
  }
  Rule {
    Widget: TextField
    Part: prefix
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: suffix
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: supporting
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: supporting
    State: error
    Style { Foreground: error }
  }
  Rule {
    Widget: TextField
    Part: counter
    Style { Foreground: on_surface_variant }
  }

  # the icons
  Rule {
    Widget: TextField
    Part: leading_icon
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: trailing_icon
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: reveal_button
    Style { Background: transparent }
  }
  Rule {
    Widget: TextField
    Part: reveal_icon
    Style { Foreground: on_surface_variant }
  }
  Rule {
    Widget: TextField
    Part: error_icon
    Style { Foreground: error }
  }
}
