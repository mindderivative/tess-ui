---
TDL: 0.2
Name: Settings
Tesserae: "0.6"
---
Container {
  Classes: [page]
  Children {
    Text {
      Name: title
      Classes: [heading]
      Text: Settings
      Typography_Role: headline_medium
    }
    TextField {
      Name: name
      Label: "Your name"
      Text: <| name |>
      Style { Width: 240 }
    }
    Container {
      Name: buttons
      Classes: [row]
      Children {
        Button {
          Name: theme
          Label: "Light or dark"
          Variant: outlined
          Handlers {
            On_Click: toggle_dark
          }
        }
      }
    }
  }
}
