---
TDL: 0.2
Name: Home
Tesserae: "0.6"
---
# The Home screen. `Home_ViewModel.py` navigates; `app.state.came_from` is the app's shared state.
Container {
  Name: Home
  Style { Flex_Direction: vertical, Width: 240, Height: 150, Gap: 8, Padding: 16, Background: surface }
  Children {
    Text {
      Name: label
      Text: Home
      Typography_Role: headline_small
      Style { Foreground: on_surface }
    }
    Text {
      Name: came_from
      Text: <| app.state.came_from |>
      Typography_Role: body_medium
      Style { Foreground: on_surface_variant }
    }
    Button {
      Name: button
      Label: "Open settings"
      Style { Width: 160 }
      Handlers {
        On_Click: go_to_settings
      }
    }
  }
}
