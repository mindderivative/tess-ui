---
# The Files panel: a view named like a screen, shown by the Dock in Window_View.yaml.
Container {
  Style { Flex_Direction: vertical, Gap: 8, Padding: 16 }
  Children {
    Text {
      Name: line0
      Text: app.py
      Typography_Role: body_medium
      Style { Foreground: on_surface }
    }
    Text {
      Name: line1
      Text: Window_View.yaml
      Typography_Role: body_medium
      Style { Foreground: on_surface }
    }
    Text {
      Name: line2
      Text: Home_View.yaml
      Typography_Role: body_medium
      Style { Foreground: on_surface }
    }
    Text {
      Name: line3
      Text: Notes_View.yaml
      Typography_Role: body_medium
      Style { Foreground: on_surface }
    }
  }
}
