---
TDL: 0.2
Name: Main
Tesserae: "0.6"
---
# The look of the configuration window (Main_View.yaml): every Text reads in on_surface unless its call says otherwise, the editor sits on a surface of its own, and an Icon takes the colour of the text
# beside it. Colours are theme roles, so the window follows the desktop's light and dark setting like any Tesserae UI application.
Styles {
  Rule { Widget: Text, Style { Foreground: on_surface } }
  Rule { Widget: TextInput, Style { Foreground: on_surface, Background: surface, Corner_Radius: 8, Padding: 8 } }
  Rule { Widget: Icon, Style { Foreground: on_surface } }
  # Trees here are dense lists of blocks and files, not 56 pixel Material rows: 4 pixels in, 16 per level, 4 between the parts.
  Rule { Widget: TreeNode, Style { Padding: <| {'left': 4 + 16 * level, 'right': 4, 'top': 0, 'bottom': 0} |>, Gap: 4 } }
  Rule { Widget: TreeNode, Part: label, Style { Flex: expand_horizontal, Min_Width: 0 } }
}
