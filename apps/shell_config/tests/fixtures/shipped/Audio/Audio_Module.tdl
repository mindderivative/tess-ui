---
TDL: 0.1
Shell: 0.1
Name: Audio
---

# The default sound output (Audio Module): an icon for the kind of output and the level, a mute
# toggle on click, a volume step on scroll, the list of outputs on a secondary click, an optional
# percent number and slider, and a mark while the microphone is muted. The Python sends `ready`,
# `volume`, `volume_text`, `muted`, `kind`, `name`, `mic_muted`, `has_mic`, `outputs`, `icon`,
# `tooltip` and `label`. With no sound server `ready` is false and the module is hidden: its root
# is `Visible: false`, which takes no space in the Bar and shows no placeholder.
#
# A scroll step changes the volume by `step` percent, up for a scroll up (`event.delta` is +1 for
# a step down, so the layout negates it). The secondary click opens the Popup named
# `Audio_Outputs` of the same Monitor (a Popup with `Audio_Outputs { }` as its content, see that
# module); without one the click logs a warning and nothing else happens.
#
# Muted is shown by the icon's shape AND by the muted colour (the colour is never the only sign):
# the two icons are boxes' children that exist from the start, one shown at a time with `Visible:`
# (the Battery's lesson, M5b: a state change creates and removes no node). The slider's drag sends
# the volume at most 20 times a second (`drag`); the release sends the final value (`set_volume`).
Module {
    Style: Audio_Style.tdl

    Params {
        # the volume's number next to the icon
        show_percent { Type: boolean, Default: false }
        # a volume slider on the Bar
        show_slider { Type: boolean, Default: false }
        # a mark while the default microphone is muted
        show_mic { Type: boolean, Default: true }
        # percent per scroll step
        step { Type: number, Default: 5 }
    }

    FlexBox {
        Name: Root
        Visible: {{ ready }}
        Role: GROUP
        Label: {{ label }}
        Flex: HORIZONTAL
        Align_Items: CENTER
        Spacing: 4
        On_Scroll { Action: step, delta: {{ 0 - event.delta * params.step }} }
        On_Secondary_Click: show_outputs
        Tooltip {
            Alignment: CENTER
            Gap: 4
            Style {
                Background: $color.surface_raised
                Corner_Radius: 8
                Elevation: 20%
            }
            Children {
                FlexBox {
                    Padding: [12, 8, 12, 8]
                    Children {
                        Text {
                            Text: {{ tooltip }}
                            Width: AUTO
                            Height: AUTO
                            Font_Size: 14
                            Foreground: $color.on_surface
                        }
                    }
                }
            }
        }
        Children {
            FlexBox {
                Name: Toggle
                Role: BUTTON
                Label: {{ "Unmute" if muted else "Mute" }}
                Width: 32
                Height: 32
                Align_Items: CENTER
                Justify_Content: CENTER
                On_Click: toggle_mute
                Children {
                    SVG {
                        Name: Glyph
                        Icon: {{ icon }}
                        Visible: {{ not muted }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                    }
                    SVG {
                        Name: Glyph_Muted
                        Icon: {{ icon }}
                        Visible: {{ muted }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                        Foreground: $color.on_surface_muted
                    }
                }
            }
            If {{ params.show_percent }} {
                Text { Name: Percent, Class: audio_text, Text: {{ volume_text }} }
            }
            If {{ params.show_slider }} {
                Slider {
                    Name: Volume
                    Label: "Volume"
                    Value: {{ volume }}
                    Max: 100
                    On_Changed { Action: drag, percent: {{ event.value }} }
                    On_Released { Action: set_volume, percent: {{ event.value }} }
                }
            }
            SVG {
                Name: Mic
                Icon: "mdi:microphone-off"
                Visible: {{ params.show_mic and mic_muted }}
                Width: 16
                Height: 16
                Foreground: $color.on_surface_muted
                Label: "Microphone muted"
            }
        }
    }
}
