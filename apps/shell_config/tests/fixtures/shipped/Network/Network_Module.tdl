---
TDL: 0.1
Shell: 0.1
Name: Network
---

# How the machine is connected (Network Module): an icon for the kind of connection and its state
# (a Wi-Fi icon has four signal steps), a second `vpn` icon while a VPN is up, an optional connection
# name, and a tooltip with the name, the kind and the state. The Python sends `ready`, `state`,
# `kind`, `name`, `strength`, `vpn`, `icon`, `tooltip` and `label`; the layer sends `available`
# (NetworkManager is on the system bus). With NetworkManager absent the module is hidden: its root
# is `Visible: false`, which takes no space in the Bar and shows no placeholder. A machine that is
# disconnected or has networking off is NOT hidden: the icon says so (`network-off`, `wifi-off`).
#
# The state sets the colour: `LIMITED` and `PORTAL` the theme's warning colour, `DISCONNECTED`,
# `DISABLED` and `UNKNOWN` the muted one, the others the text colour (the icon also changes shape:
# the colour is never the only sign). The looks are three boxes that exist from the start, one shown
# at a time with `Visible:`, and the VPN icon is shown with `Visible:` too: a change of state or of
# VPN creates and removes no node and changes no icon's colour, only which box shows and the
# document of each icon (the Battery's lesson, M5b). The Root keeps its size from the box that
# shows, so the tooltip's hover area never depends on an icon.
Module {
    Style: Network_Style.tdl

    Params {
        # the connection's name (or the Wi-Fi network's) next to the icon
        show_name { Type: boolean, Default: false }
        # the second icon while a VPN is up
        show_vpn { Type: boolean, Default: true }
    }

    FlexBox {
        Name: Root
        Visible: {{ available and ready }}
        Role: GROUP
        Label: {{ label }}
        Flex: HORIZONTAL
        Align_Items: CENTER
        Tooltip {
            Alignment: CENTER
            Gap: 4
            Style {
                Background: $color.surface_raised
                Corner_Radius: 8
                Elevation: 20%
            }
            Children {
                FlexBox {
                    Padding: [12, 8, 12, 8]
                    Children {
                        Text {
                            Text: {{ tooltip }}
                            Width: AUTO
                            Height: AUTO
                            Font_Size: 14
                            Foreground: $color.on_surface
                        }
                    }
                }
            }
        }
        Children {
            FlexBox {
                Name: Level
                Visible: {{ state == "CONNECTED" or state == "CONNECTING" }}
                Flex: HORIZONTAL
                Align_Items: CENTER
                Spacing: 4
                Children {
                    SVG {
                        Name: Glyph
                        Icon: {{ icon }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                    }
                    SVG {
                        Name: Vpn
                        Icon: "mdi:vpn"
                        Visible: {{ params.show_vpn and vpn }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                    }
                    If {{ params.show_name }} {
                        Text {
                            Name: Label
                            Class: network_text
                            Text: {{ name }}
                        }
                    }
                }
            }
            FlexBox {
                Name: Level_Warn
                Visible: {{ state == "LIMITED" or state == "PORTAL" }}
                Flex: HORIZONTAL
                Align_Items: CENTER
                Spacing: 4
                Children {
                    SVG {
                        Name: Glyph_Warn
                        Icon: {{ icon }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                        Foreground: $color.warning
                    }
                    SVG {
                        Name: Vpn_Warn
                        Icon: "mdi:vpn"
                        Visible: {{ params.show_vpn and vpn }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                        Foreground: $color.warning
                    }
                    If {{ params.show_name }} {
                        Text {
                            Name: Label_Warn
                            Class: network_text
                            Text: {{ name }}
                            Foreground: $color.warning
                        }
                    }
                }
            }
            FlexBox {
                Name: Level_Muted
                Visible: {{ state == "DISCONNECTED" or state == "DISABLED" or state == "UNKNOWN" }}
                Flex: HORIZONTAL
                Align_Items: CENTER
                Spacing: 4
                Children {
                    SVG {
                        Name: Glyph_Muted
                        Icon: {{ icon }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                        Foreground: $color.on_surface_muted
                    }
                    SVG {
                        Name: Vpn_Muted
                        Icon: "mdi:vpn"
                        Visible: {{ params.show_vpn and vpn }}
                        Width: 16
                        Height: 16
                        A11y_Hidden: true
                        Foreground: $color.on_surface_muted
                    }
                    If {{ params.show_name }} {
                        Text {
                            Name: Label_Muted
                            Class: network_text
                            Text: {{ name }}
                            Foreground: $color.on_surface_muted
                        }
                    }
                }
            }
        }
    }
}
