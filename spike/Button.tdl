---
TDL: 0.1
Name: View
Tesserae: "0.6"
---

Container {
  Params {
    label {
      type: "str"
      default: ""
      doc: "The text."
    }
    variant {
      type: "enum"
      choices: ["filled", "tonal", "elevated", "outlined", "text"]
      default: "filled"
      doc: "filled is the screen's main action; tonal and elevated are important but secondary; outlined is medium; text is the lowest emphasis."
    }
    size {
      type: "enum"
      choices: ["xs", "s", "m", "l", "xl"]
      default: "s"
      doc: "32, 40, 56, 96 or 136 pixels tall."
    }
    shape {
      type: "enum"
      choices: ["round", "square"]
      default: "round"
      doc: "A pill, or a rounded square. A toggle button swaps to the other shape while selected."
    }
    icon {
      type: "str"
      default: ""
      doc: "A leading icon."
    }
    trailing_icon {
      type: "str"
      default: ""
      doc: "An icon after the label."
    }
    disabled {
      type: "bool"
      default: false
      doc: "Dimmed, not focusable, and it does not respond."
    }
    loading {
      type: "bool"
      default: false
      doc: "A spinner in the icon's place; it does not respond while it shows."
    }
    toggle {
      type: "bool"
      default: false
      doc: "A toggle button: it has an on and an off look, and a press flips `selected`."
    }
    flip {
      type: "bool"
      default: true
      doc: "For a toggle: whether a press flips `selected` itself. Off, the caller decides (a group of buttons does)."
    }
    selected {
      type: "bool"
      default: false
      model: true
      doc: "For a toggle button: whether it is on."
    }
  }
  interaction: true
  disabled: {{ disabled or loading }}
  Style {
    flex_direction: "horizontal"
    align_content: "center"
    clip_children: false
  }
  Handlers {
    on_click: "selected = (not selected) if (toggle and flip) else selected"
  }
  A11y {
    role: "button"
    label: {{ label }}
    pressed: {{ selected if toggle else None }}
    busy: {{ loading }}
  }
  Children {
    If {{ loading }} {
      CircularProgress {
        Name: spinner
        Style {
          width: {{ {'xs': 20, 's': 18, 'm': 24, 'l': 32, 'xl': 40}[size] }}
          height: {{ {'xs': 20, 's': 18, 'm': 24, 'l': 32, 'xl': 40}[size] }}
        }
      }
    }
    If {{ icon != '' and not loading }} {
      Icon {
        Name: icon
        icon: {{ icon }}
      }
    }
    If {{ label != '' }} {
      Text {
        Name: label
        text: {{ label }}
        typography_role: {{ {'xs': 'label_large', 's': 'label_large', 'm': 'title_medium', 'l': 'headline_small', 'xl': 'headline_large'}[size] }}
      }
    }
    If {{ trailing_icon != '' }} {
      Icon {
        Name: trailing
        icon: {{ trailing_icon }}
      }
    }
  }
}
