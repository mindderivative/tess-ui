---
TDL: 0.1
Name: View
Tesserae: "0.6"
---

Container {
  Params {
    variant {
      type: "enum"
      choices: ["elevated", "filled", "outlined"]
      default: "elevated"
      doc: "elevated has a shadow, filled a higher surface, outlined a border."
    }
    headline {
      type: "str"
      default: ""
      doc: "The title."
    }
    subhead {
      type: "str"
      default: ""
      doc: "A line under the title."
    }
    text {
      type: "str"
      default: ""
      doc: "Supporting text."
    }
    media {
      type: "str"
      default: ""
      doc: "A picture across the top, relative to the view."
    }
    media_height {
      type: "float"
      default: 160
      doc: "How tall the picture is."
    }
    actionable {
      type: "bool"
      default: false
      doc: "The whole card is one pressable surface."
    }
    selected {
      type: "bool"
      default: false
      doc: "Whether the card is chosen (the caller decides when)."
    }
    disabled {
      type: "bool"
      default: false
      doc: "Dimmed, and an actionable card does not respond."
    }
  }
  interaction: {{ actionable }}
  disabled: {{ disabled }}
  Style {
    flex_direction: "vertical"
    clip_children: true
  }
  A11y {
    role: {{ 'button' if actionable else 'group' }}
    label: {{ headline }}
    selected: {{ selected if selected else None }}
  }
  Children {
    If {{ media != '' }} {
      Image {
        Name: picture
        src: {{ media }}
        fit: "cover"
        Style {
          width: "100%"
          height: {{ media_height }}
        }
      }
    }
    Container {
      Name: body
      Style {
        flex_direction: "vertical"
      }
      Children {
        If {{ headline != '' }} {
          Text {
            Name: headline
            text: {{ headline }}
            typography_role: "title_large"
          }
        }
        If {{ subhead != '' }} {
          Text {
            Name: subhead
            text: {{ subhead }}
            typography_role: "title_small"
          }
        }
        If {{ text != '' }} {
          Text {
            Name: text
            text: {{ text }}
            typography_role: "body_medium"
          }
        }
        Slot {
        }
        Container {
          Name: actions
          Style {
            flex_direction: "horizontal"
            align_content: "right"
            gap: 8
          }
          Children {
            Slot {
              Name: actions
            }
          }
        }
      }
    }
  }
}
